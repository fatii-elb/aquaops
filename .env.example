# AquaOps — environment variables (proposal v0, TECH-3)
# Copy this file to .env for your own values. .env is NEVER committed.
# Every service also has a local default, so you need NOTHING to start locally.

# --- Shared infrastructure ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_HOST=localhost
DB_PORT=5432
DB_USER=aquaops
DB_PASSWORD=change-me
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/aquaops
# Keycloak admin console account, read by deploy/docker-compose.yml.
# Local demo credentials only: NEVER use them anywhere else (shared VM, production).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Ports ---
GATEWAY_PORT=8080
TELEMETRY_PORT=8081
ASSETS_PORT=8082
DETECTION_PORT=8083
INCIDENTS_PORT=8084
NOTIFICATIONS_PORT=8085
SIMULATOR_PORT=8086

# --- Where the gateway forwards requests ---
TELEMETRY_URL=http://localhost:8081
ASSETS_URL=http://localhost:8082
DETECTION_URL=http://localhost:8083
INCIDENTS_URL=http://localhost:8084
NOTIFICATIONS_URL=http://localhost:8085

# --- Databases (one per service, proposal) ---
ASSETS_DB_URL=jdbc:postgresql://localhost:5432/aquaops_assets
TELEMETRY_DB_URL=jdbc:postgresql://localhost:5432/aquaops_telemetry
INCIDENTS_DB_URL=jdbc:postgresql://localhost:5432/aquaops_incidents
