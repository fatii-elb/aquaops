<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ma.aquaops</groupId>
	<artifactId>eureka-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>eureka-server</name>
	<description>AquaOps service registry (Spring Cloud Netflix Eureka)</description>

	<properties>
		<java.version>21</java.version>
		<!-- Same train as gateway and assets-service. 2025.1.x supports
		     Spring Boot 4.1.x from 2025.1.2 on (Spring Cloud compatibility table). -->
		<spring-cloud.version>2025.1.4</spring-cloud.version>
		<!-- No tomcat.version / freemarker.version override any more: Boot 4.1.2
		     manages Tomcat 11.0.27 and FreeMarker 2.3.35, both past the fixed
		     versions of the former Trivy CRITICAL (Tomcat 11.0.24: CVE-2026-65182,
		     -65637, -65905, -68525; FreeMarker 2.3.34: CVE-2026-84939). Keeping the
		     old pin 11.0.25 would DOWNGRADE Tomcat. -->
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- SCA (docs/security-scans.md): Eureka 2.0.6 still brings guava 33.0.0-jre
			     (CVE-2026-102554, HIGH). Declared here, it wins over the imported BOM.
			     Remove once Spring Cloud manages a fixed version. -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.7.2-jre</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Coverage report, no minimum (docs/testing.md, section 7). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
