# AquaOps TEST environment: variables read by deploy/test/compose.yml
# (and compose.infra.yml). Placeholders only.
# Copy to deploy/test/.env (git-ignored) and replace EVERY "change-me".
# Never commit the real .env. Never reuse local or integration passwords.

# --- Images: which build to run ---------------------------------------------
# Full commit SHA built by the "Images" workflow. Required, no default:
# the deploy job sets it, so the VM always runs an exact, tested commit.
IMAGE_TAG=change-me
# Registry namespace. Default: ghcr.io/fatii-elb/aquaops
# IMAGE_NAMESPACE=ghcr.io/fatii-elb/aquaops

# --- Database ---------------------------------------------------------------
# Infrastructure in Docker (compose.infra.yml): DB_HOST=postgres
# External PostgreSQL: its host name, as seen from the containers.
DB_HOST=postgres
# DB_PORT=5432
DB_USER=aquaops
DB_PASSWORD=change-me

# --- Kafka ------------------------------------------------------------------
# Infrastructure in Docker: kafka:9092. External broker: its address.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---------------------------------------------------------------
# Must equal the "iss" claim of the tokens (to agree with E2).
# Infrastructure in Docker: http://keycloak:8180/realms/aquaops
KEYCLOAK_ISSUER_URI=http://keycloak:8180/realms/aquaops
# Admin account, only used by compose.infra.yml.
KEYCLOAK_ADMIN=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Host exposure (127.0.0.1 = only from the VM itself) --------------------
# GATEWAY_BIND=127.0.0.1
# GATEWAY_HOST_PORT=8080
# KEYCLOAK_BIND=127.0.0.1
# KEYCLOAK_HOST_PORT=8180

# --- Resources --------------------------------------------------------------
# Memory limit per Java service (7 services). Default: 768m
# JAVA_MEM_LIMIT=768m
