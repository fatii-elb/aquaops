# AquaOps integration stack: variables read by docker-compose.integration.yml.
# Copy to deploy/integration/.env (git-ignored) and replace EVERY "change-me".
# Never commit the real .env. Never reuse these values on the VM.

# --- Required: Compose refuses to start without them -------------------------
DB_USER=aquaops
DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
SIMULATOR_API_KEY=change-me
TELEMETRY_INGEST_RATE_LIMIT=500

# --- Optional: host ports, all bound to 127.0.0.1 ----------------------------
# Different from the dev stack (8080, 8180, 9092) so both can run together.
# INTEGRATION_GATEWAY_PORT=18080
# INTEGRATION_KEYCLOAK_PORT=18180
# INTEGRATION_KAFKA_PORT=19092

# --- Optional: issuer checked by assets-service ------------------------------
# Must equal the "iss" claim of the tokens. Default: Keycloak's internal name,
# see the Keycloak blocker in docker-compose.integration.yml.
# KEYCLOAK_ISSUER_URI=http://keycloak:8180/realms/aquaops
